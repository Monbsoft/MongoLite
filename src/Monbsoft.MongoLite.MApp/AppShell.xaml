<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Monbsoft.MongoLite.MApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Monbsoft.MongoLite.MApp.Pages"
    Title="MongoDB Desktop Viewer">

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalOptions="Center" ColumnSpacing="10">
            <Label Grid.Column="0"
                   Text="MongoLite"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    x:Name="EnvironmentBanner"
                    Padding="8,4"
                    StrokeShape="RoundRectangle 4"
                    StrokeThickness="0"
                    IsVisible="False"
                    VerticalOptions="Center"
                    HorizontalOptions="Start">
                <Label x:Name="EnvironmentLabel"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Border>
            <Button Grid.Column="3"
                    Text="⚙"
                    FontSize="18"
                    Clicked="OnSettingsClicked"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <ShellContent
        Title="Connection"
        ContentTemplate="{DataTemplate pages:ConnectionPage}"
        Route="connection" />

</Shell>
