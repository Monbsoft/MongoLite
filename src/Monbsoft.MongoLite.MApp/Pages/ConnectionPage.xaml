<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Monbsoft.MongoLite.MApp.ViewModels"
             xmlns:models="clr-namespace:Monbsoft.MongoLite.MApp.Models"
             xmlns:converters="clr-namespace:Monbsoft.MongoLite.MApp.Converters"
             x:Class="Monbsoft.MongoLite.MApp.Pages.ConnectionPage"
             x:DataType="viewmodels:ConnectionViewModel"
             Title="MongoDB Connection">

    <ContentPage.Resources>
        <converters:EnvironmentColorConverter x:Key="EnvironmentColorConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" MaximumWidthRequest="600">

            <Label Text="MongoDB Desktop Viewer"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <!-- Saved Connections -->
            <Label Text="Connexions sauvegardées"
                   FontSize="16"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding SavedConnections}"
                            SelectedItem="{Binding SelectedSavedConnection, Mode=TwoWay}"
                            SelectionMode="Single"
                            HeightRequest="150">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedConnection">
                        <Border Padding="8" Margin="0,2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6">
                            <HorizontalStackLayout Spacing="10">
                                <BoxView WidthRequest="6" HeightRequest="30"
                                         Color="{Binding Environment, Converter={StaticResource EnvironmentColorConverter}}"
                                         CornerRadius="3"
                                         VerticalOptions="Center" />
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Environment}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Aucune connexion sauvegardée"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,20" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Connection Form -->
            <BoxView HeightRequest="1" Color="Gray" Margin="0,5" />

            <Label Text="Nom de la connexion :"
                   FontAttributes="Bold" />
            <Entry Text="{Binding ConnectionName}"
                   Placeholder="Ma connexion dev" />

            <Label Text="Environnement :"
                   FontAttributes="Bold" />
            <Picker ItemsSource="{Binding EnvironmentTypes}"
                    SelectedItem="{Binding SelectedEnvironment}" />

            <Label Text="Connection String :"
                   FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Entry Text="{Binding ConnectionString}"
                       Placeholder="mongodb://admin:password@localhost:27017/testdb"
                       HorizontalOptions="FillAndExpand" />
                <Button Text="Advanced"
                        Command="{Binding OpenAdvancedFormCommand}"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button Text="Connecter"
                        Command="{Binding ConnectCommand}" />
                <Button Text="Tester"
                        Command="{Binding TestConnectionCommand}" />
                <Button Text="Enregistrer"
                        Command="{Binding SaveConnectionCommand}" />
                <Button Text="Supprimer"
                        Command="{Binding DeleteConnectionCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsConnecting}"
                               IsVisible="{Binding IsConnecting}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
