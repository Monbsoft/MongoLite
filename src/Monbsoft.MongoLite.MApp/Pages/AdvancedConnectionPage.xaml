<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Monbsoft.MongoLite.MApp.ViewModels"
             x:Class="Monbsoft.MongoLite.MApp.Pages.AdvancedConnectionPage"
             x:DataType="viewmodels:AdvancedConnectionViewModel"
             Title="Advanced Connection">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" MaximumWidthRequest="500">

            <Label Text="Advanced MongoDB Connection"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Label Text="Host:" FontAttributes="Bold" />
            <Entry Text="{Binding Host}"
                   Placeholder="localhost" />

            <Label Text="Port:" FontAttributes="Bold" />
            <Entry Text="{Binding Port}"
                   Placeholder="27017"
                   Keyboard="Numeric" />

            <Label Text="Username (Optional):" FontAttributes="Bold" />
            <Entry Text="{Binding Username}"
                   Placeholder="admin" />

            <Label Text="Password (Optional):" FontAttributes="Bold" />
            <Entry Text="{Binding Password}"
                   Placeholder="password"
                   IsPassword="True" />

            <Label Text="Database:" FontAttributes="Bold" />
            <Entry Text="{Binding Database}"
                   Placeholder="testdb" />

            <Label Text="Auth Source (Optional):" FontAttributes="Bold" />
            <Entry Text="{Binding AuthSource}"
                   Placeholder="admin" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,10,0,0">
                <Button Text="Connecter"
                        Command="{Binding ConnectCommand}" />
                <Button Text="Retour"
                        Clicked="OnBackClicked" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsConnecting}"
                               IsVisible="{Binding IsConnecting}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
