<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Monbsoft.MongoLite.MApp.ViewModels"
             x:Class="Monbsoft.MongoLite.MApp.Pages.ConnectionPage"
             x:DataType="viewmodels:ConnectionViewModel"
             Title="MongoDB Connection">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" MaximumWidthRequest="500">

            <Label Text="MongoDB Desktop Viewer"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Label Text="Connection String:"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="10">
                <Entry Text="{Binding ConnectionString}"
                       Placeholder="mongodb://admin:password@localhost:27017/testdb"
                       HorizontalOptions="FillAndExpand" />
                <Button Text="⚙️ Advanced"
                        Command="{Binding OpenAdvancedFormCommand}"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button Text="Connect"
                        Command="{Binding ConnectCommand}" />
                <Button Text="Test"
                        Command="{Binding TestConnectionCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsConnecting}"
                               IsVisible="{Binding IsConnecting}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
