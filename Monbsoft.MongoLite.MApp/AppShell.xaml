<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Monbsoft.MongoLite.MApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Monbsoft.MongoLite.MApp.Pages"
    Title="MongoDB Desktop Viewer">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Label Text="MongoLite"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Text="☀/🌙"
                    FontSize="14"
                    Clicked="OnToggleThemeClicked"
                    VerticalOptions="Center"
                    HorizontalOptions="EndAndExpand" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ShellContent
        Title="Connection"
        ContentTemplate="{DataTemplate pages:ConnectionPage}"
        Route="connection" />

</Shell>
